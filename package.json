{
  "name": "agents-everywhere-starter-kit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Starter kit for the Agents, Everywhere: Bots, Channels & More global hackathon.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev --filter=web",
    "dev:web": "turbo run dev --filter=web",
    "dev:slack": "turbo run dev --filter=channel",
    "channel:status": "pnpm dlx copilotkit@latest channels status --json",
    "channel:setup": "pnpm dlx copilotkit@latest channels setup",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "verify": "turbo run typecheck test"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.23.1",
    "typescript": "^5.7.0",
    "turbo": "2.10.12"
  },
  "packageManager": "pnpm@9.12.0",
  "pnpm": {
    "overrides": {
      "@ag-ui/client": "0.0.59"
    }
  }
}
